{
  "manifest_version": 2,
  "name": "Ruwa Mods",
  "version": "1.0",
  "description": "Bundled Ruwa mods for WhatsApp Web",
  "content_scripts": [
    {
      "matches": ["*://web.whatsapp.com/*"],
      "js": ["loader.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ruwa-mods@ruwa"
    }
  }
}
