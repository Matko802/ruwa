{
    "manifest_version": 2,
    "name": "Ruwa Topbar",
    "version": "1.0",

    "description": "Ruwa quick actions in the toolbar",

    "browser_action": {
        "default_area": "navbar",
        "default_title": "Ruwa",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon16.png",
            "32": "icon32.png",
            "48": "icon48.png"
        }
    },

    "icons": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png"
    },

    "browser_specific_settings": {
        "gecko": {
          "id": "ruwa-topbar@rused",
          "strict_min_version": "1.0"
        }
      },

    "permissions": [
        "tabs"
      ]
  }
